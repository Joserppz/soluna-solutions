# Configuración de entorno del Frontend ASPAR (SCRUM-59 / SCRUM-89)
# Copia este archivo como .env (no se sube a git).

# URL base de la API FastAPI. Todas las pantallas leen y guardan los datos ahí: el
# Frontend ya no tiene un modo local de demostración (ADR-008, retirada).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# La duración de la sesión (30 min y 15 min de inactividad) la define el Backend
# (SESSION_MAX_AGE_SECONDS y SESSION_IDLE_LIMIT_SECONDS en Backend/.env).

# Claves públicas de los servicios externos (ingreso con Google y Turnstile en el registro,
# la recuperación y los formularios del sitio). Ver docs/despliegue/GUIA_DE_DESPLIEGUE.md.
# Google Cloud -> Credenciales -> ID de cliente OAuth (el mismo que GOOGLE_CLIENT_ID del Backend)
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile -> Site Key. Esta es la clave de prueba de Cloudflare (siempre aprueba)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
