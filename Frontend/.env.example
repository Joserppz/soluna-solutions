# Configuración de entorno del Frontend ASPAR (SCRUM-59 / SCRUM-89)
# Copia este archivo como .env (no se sube a git).

# URL base de la API FastAPI. Si la API no responde, el Frontend usa el modo
# local de demostración (ADR-008).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Modo local de demostración (ADR-008): permite entrar con las cuentas de prueba
# cuando la API no responde. Siempre activo con `npm run dev`; en un build de
# producción solo si se pone en true (por ejemplo, para una demo sin servidor).
VITE_DEMO_MODE=false

# La duración de la sesión (30 min y 15 min de inactividad) la define el Backend
# (SESSION_MAX_AGE_SECONDS y SESSION_IDLE_LIMIT_SECONDS en Backend/.env).

# Claves públicas de los servicios externos (las usan las pantallas de login y registro
# a medida que se migran a src/api/). Ver docs/despliegue/GUIA_DE_DESPLIEGUE.md.
# Google Cloud -> Credenciales -> ID de cliente OAuth (el mismo que GOOGLE_CLIENT_ID del Backend)
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile -> Site Key. Esta es la clave de prueba de Cloudflare (siempre aprueba)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
