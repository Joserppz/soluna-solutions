<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_AsIsActividades" targetNamespace="https://github.com/Joserppz/soluna-solutions/bpmn" exporter="ASPAR SCRUM-192" exporterVersion="1.0">
  <bpmn:process id="AsIsActividades" name="AS-IS: Actividades sabatinas, multimedia, inventario y donaciones (proceso actual)" isExecutable="false">
    <bpmn:startEvent id="AsIsActividades_s" name="Semana de actividades sabatinas">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="AsIsActividades_t1" name="Avisar el cronograma por WhatsApp">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsActividades_t2" name="Realizar la actividad sabatina">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsActividades_t3" name="Anotar la asistencia en papel">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsActividades_t4" name="Tomar fotos y videos">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="AsIsActividades_g1" name="¿Hay espacio en Drive/Gmail?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="AsIsActividades_t5" name="Subir a Drive y redes sociales">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsActividades_t6" name="Borrar material o dejarlo en el celular">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="AsIsActividades_g2">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="AsIsActividades_t7" name="Actualizar inventario en papel">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsActividades_t8" name="Recibir aportes sin registro público">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="AsIsActividades_e" name="Datos dispersos en papel, WhatsApp y Drive">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="AsIsActividades_s" targetRef="AsIsActividades_t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="AsIsActividades_t1" targetRef="AsIsActividades_t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="AsIsActividades_t2" targetRef="AsIsActividades_t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="AsIsActividades_t3" targetRef="AsIsActividades_t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="AsIsActividades_t4" targetRef="AsIsActividades_g1" />
    <bpmn:sequenceFlow id="f6" name="Sí" sourceRef="AsIsActividades_g1" targetRef="AsIsActividades_t5" />
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="AsIsActividades_g1" targetRef="AsIsActividades_t6" />
    <bpmn:sequenceFlow id="f8" sourceRef="AsIsActividades_t5" targetRef="AsIsActividades_g2" />
    <bpmn:sequenceFlow id="f9" sourceRef="AsIsActividades_t6" targetRef="AsIsActividades_g2" />
    <bpmn:sequenceFlow id="f10" sourceRef="AsIsActividades_g2" targetRef="AsIsActividades_t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="AsIsActividades_t7" targetRef="AsIsActividades_t8" />
    <bpmn:sequenceFlow id="f12" sourceRef="AsIsActividades_t8" targetRef="AsIsActividades_e" />
  </bpmn:process>
