<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_ToBeActividades" targetNamespace="https://github.com/Joserppz/soluna-solutions/bpmn" exporter="ASPAR SCRUM-192" exporterVersion="1.0">
  <bpmn:process id="ToBeActividades" name="TO-BE: Actividades, multimedia, inventario y donaciones (proceso propuesto)" isExecutable="false">
    <bpmn:startEvent id="ToBeActividades_s" name="Inicio de la semana de actividades">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ToBeActividades_p1">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ToBeActividades_t1" name="Publicar actividad (RF-04)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ToBeActividades_t2" name="Mostrar cronograma público (RF-10)">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ToBeActividades_t3" name="Marcar asistencia">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ToBeActividades_g1" name="¿Consentimiento vigente?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBeActividades_t4" name="Registrar la asistencia">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ToBeActividades_t5" name="Bloquear «Presente» (RNF-06)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBeActividades_g2">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ToBeActividades_t6" name="Subir fotos y videos a la nube (RF-05)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ToBeActividades_t7" name="Registrar o dar de baja material (RF-03)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ToBeActividades_t8" name="Exportar reporte a la Alcaldía (RF-09)">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ToBeActividades_t9" name="Donar por QR o Libélula (RF-06)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ToBeActividades_t10" name="Registrar aporte en el contador">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ToBeActividades_p2">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="ToBeActividades_e" name="Información centralizada y auditada">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
