<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_ToBeAfiliacion" targetNamespace="https://github.com/Joserppz/soluna-solutions/bpmn" exporter="ASPAR SCRUM-192" exporterVersion="1.0">
  <bpmn:process id="ToBeAfiliacion" name="TO-BE: Autenticación, afiliación y consentimiento (proceso propuesto, Sprint 1)" isExecutable="false">
    <bpmn:startEvent id="ToBeAfiliacion_s" name="El personal abre /login">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ToBeAfiliacion_t1" name="Ingresar correo y contraseña">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ToBeAfiliacion_t2" name="Validar credenciales (bcrypt)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBeAfiliacion_g1" name="¿Válidas y cuenta activa?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBeAfiliacion_t3" name="Registrar intento; al 5.º bloquear 15 min">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ToBeAfiliacion_e0" name="Acceso denegado">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ToBeAfiliacion_t4" name="Crear sesión JWT (30/15 min) y auditar">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ToBeAfiliacion_t5" name="Registrar filiación y cuidador">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ToBeAfiliacion_g2" name="¿Datos válidos y CI nueva?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ToBeAfiliacion_t6" name="Corregir los datos indicados">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ToBeAfiliacion_t7" name="Guardar ficha en PostgreSQL y auditar">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBeAfiliacion_g3" name="¿Consentimiento informado firmado?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBeAfiliacion_t8" name="Acceso «Pendiente»: anamnesis protegida">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ToBeAfiliacion_e1" name="Ficha digital protegida">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ToBeAfiliacion_t9" name="Marcar consentimiento y acceso «Activo»">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ToBeAfiliacion_t10" name="Registrar anamnesis y evaluaciones">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ToBeAfiliacion_e2" name="Expediente clínico activo">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="ToBeAfiliacion_s" targetRef="ToBeAfiliacion_t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="ToBeAfiliacion_t1" targetRef="ToBeAfiliacion_t2" />
