    <bpmn:sequenceFlow id="f9" name="No" sourceRef="ToBeAfiliacion_g2" targetRef="ToBeAfiliacion_t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="ToBeAfiliacion_t6" targetRef="ToBeAfiliacion_t5" />
    <bpmn:sequenceFlow id="f11" name="Sí" sourceRef="ToBeAfiliacion_g2" targetRef="ToBeAfiliacion_t7" />
    <bpmn:sequenceFlow id="f12" sourceRef="ToBeAfiliacion_t7" targetRef="ToBeAfiliacion_g3" />
    <bpmn:sequenceFlow id="f13" name="No" sourceRef="ToBeAfiliacion_g3" targetRef="ToBeAfiliacion_t8" />
    <bpmn:sequenceFlow id="f14" sourceRef="ToBeAfiliacion_t8" targetRef="ToBeAfiliacion_e1" />
    <bpmn:sequenceFlow id="f15" name="Sí" sourceRef="ToBeAfiliacion_g3" targetRef="ToBeAfiliacion_t9" />
    <bpmn:sequenceFlow id="f16" sourceRef="ToBeAfiliacion_t9" targetRef="ToBeAfiliacion_t10" />
    <bpmn:sequenceFlow id="f17" sourceRef="ToBeAfiliacion_t10" targetRef="ToBeAfiliacion_e2" />
  </bpmn:process>
