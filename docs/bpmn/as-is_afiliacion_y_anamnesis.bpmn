<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_AsIsAfiliacion" targetNamespace="https://github.com/Joserppz/soluna-solutions/bpmn" exporter="ASPAR SCRUM-192" exporterVersion="1.0">
  <bpmn:process id="AsIsAfiliacion" name="AS-IS: Afiliación de paciente y anamnesis (proceso actual, manual)" isExecutable="false">
    <bpmn:startEvent id="AsIsAfiliacion_s" name="Llega un paciente nuevo">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="AsIsAfiliacion_t1" name="Pedir nombre, carnet, fotocopia y dirección">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsAfiliacion_t2" name="Anotar datos del cuidador en papel">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="AsIsAfiliacion_g1" name="¿Trae certificado del neurólogo?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="AsIsAfiliacion_t3" name="Anotar el diagnóstico del certificado">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsAfiliacion_t4" name="Validar diagnóstico por síntomas">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="AsIsAfiliacion_g2">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="AsIsAfiliacion_t5" name="Evaluar (física, fono, psicológica) en hojas">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsAfiliacion_t6" name="Archivar las hojas en la sede">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="AsIsAfiliacion_t7" name="Coordinar con el equipo por WhatsApp">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="AsIsAfiliacion_e" name="Ficha en papel sin control de acceso">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="AsIsAfiliacion_s" targetRef="AsIsAfiliacion_t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="AsIsAfiliacion_t1" targetRef="AsIsAfiliacion_t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="AsIsAfiliacion_t2" targetRef="AsIsAfiliacion_g1" />
    <bpmn:sequenceFlow id="f4" name="Sí" sourceRef="AsIsAfiliacion_g1" targetRef="AsIsAfiliacion_t3" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="AsIsAfiliacion_g1" targetRef="AsIsAfiliacion_t4" />
    <bpmn:sequenceFlow id="f6" sourceRef="AsIsAfiliacion_t3" targetRef="AsIsAfiliacion_g2" />
    <bpmn:sequenceFlow id="f7" sourceRef="AsIsAfiliacion_t4" targetRef="AsIsAfiliacion_g2" />
    <bpmn:sequenceFlow id="f8" sourceRef="AsIsAfiliacion_g2" targetRef="AsIsAfiliacion_t5" />
    <bpmn:sequenceFlow id="f9" sourceRef="AsIsAfiliacion_t5" targetRef="AsIsAfiliacion_t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="AsIsAfiliacion_t6" targetRef="AsIsAfiliacion_t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="AsIsAfiliacion_t7" targetRef="AsIsAfiliacion_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AsIsAfiliacion">
    <bpmndi:BPMNPlane id="BPMNPlane_AsIsAfiliacion" bpmnElement="AsIsAfiliacion">
      <bpmndi:BPMNShape id="AsIsAfiliacion_s_di" bpmnElement="AsIsAfiliacion_s">
