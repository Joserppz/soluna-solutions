# Configuración del Backend FastAPI de ASPAR.
# Copia este archivo como .env y completa los valores (.env nunca se sube a git).
# Con Docker (docker compose up) no hace falta: docker-compose.yml ya trae valores locales.
#
# Producción y staging (Cloud Run) NO usan este archivo: los secretos (JWT_SECRET,
# DATABASE_URL, MIGRATION_DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY,
# TURNSTILE_SECRET_KEY) viven en Google Secret Manager y el resto en --env-vars-file.
# Ver docs/despliegue/GUIA_DE_DESPLIEGUE.md.

# ---------------------------------------------------------------------------
# Entorno: dev (tu PC), test (pytest) o prod (Cloud Run)
# ---------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Base de datos (Supabase -> Connect)
# ---------------------------------------------------------------------------
# API: Transaction Pooler, puerto 6543. Reemplaza <password> sin corchetes.
# En producción, con el usuario aspar_api (solo datos, sin cambios de esquema):
# postgresql://aspar_api.<project-ref>:<password>@...:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Pool de conexiones de la API: "null" con el Transaction Pooler (Supabase ya agrupa las
# conexiones) o "queue" con una base directa (Docker, PostgreSQL local).
DB_POOL=null

# Migraciones: Session Pooler, puerto 5432, con el dueño del esquema (postgres). Solo la
# usa scripts.migrate (en Cloud Run, el job aspar-migrate). Si se omite, se usa DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Sesión (RNF-02)
# ---------------------------------------------------------------------------
# Genera un valor propio: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=reemplazar-por-un-secreto-aleatorio
SESSION_MAX_AGE_SECONDS=1800
SESSION_IDLE_LIMIT_SECONDS=900
# Tope absoluto de una sesión aunque se renueve (8 horas)
SESSION_ABSOLUTE_MAX_SECONDS=28800

# Cookies de sesión (HttpOnly, SameSite). Déjalo vacío también en producción y staging:
# la cookie queda solo para el host de su API. Con .aspar.com la sesión de producción
# viajaría también a api.staging.aspar.com (ver ADR-012).
COOKIE_DOMAIN=
# true en producción (solo HTTPS). docker-compose.yml usa false para http://localhost
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Orígenes del frontend separados por coma. Cada entorno tiene su propia API:
# prod: https://aspar.com,https://www.aspar.com · staging: https://staging.aspar.com
CORS_ORIGINS=http://localhost:5173

# Límites de peticiones por IP y por cuenta (tabla rate_limits). Obligatorio true en prod
RATE_LIMITS_ENABLED=true

# Cuántos proxies de confianza agregan su IP al final de X-Forwarded-For.
# 0 en tu PC y en Docker; 1 en Google Cloud Run (su balanceador agrega la IP real del cliente).
PROXY_TRUSTED_HOPS=0

# ---------------------------------------------------------------------------
# Cuentas: correos, CAPTCHA y "Continuar con Google"
# ---------------------------------------------------------------------------
# Dirección del frontend: los enlaces de los correos apuntan aquí
FRONTEND_URL=http://localhost:5173
# console (desarrollo: el correo sale en el log), resend o brevo. En prod no se acepta console
EMAIL_PROVIDER=console
EMAIL_FROM=ASPAR <no-responder@aspar.com>
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
# Horas que dura la contraseña temporal que entrega Administración
TEMP_PASSWORD_HOURS=72
# Cloudflare Turnstile. Sin valor se usa la clave de prueba de Cloudflare (siempre aprueba);
# en prod es obligatoria una clave real (Cloudflare -> Turnstile -> tu sitio -> Secret Key)
TURNSTILE_SECRET_KEY=
# Google Cloud -> APIs y servicios -> Credenciales -> ID de cliente OAuth (aplicación web).
# Vacío = el botón "Continuar con Google" responde 503
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Documentos privados de pacientes (RNF-06): bucket PRIVADO de Supabase Storage.
# Supabase -> Project Settings -> API Keys -> service_role (secreta: solo en el Backend).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PATIENT_DOCUMENTS_BUCKET=documentos-pacientes
SIGNED_URL_SECONDS=300
