# Configuración del Backend FastAPI de ASPAR.
# Copia este archivo como .env y completa los valores (.env nunca se sube a git).
# Con Docker (docker compose up) no hace falta: docker-compose.yml ya trae valores locales.

# ---------------------------------------------------------------------------
# Entorno: dev (tu PC), test (pytest) o prod (Cloud Run)
# ---------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Base de datos (Supabase -> Connect)
# ---------------------------------------------------------------------------
# API: Transaction Pooler, puerto 6543. Reemplaza <password> sin corchetes.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Pool de conexiones de la API: "null" con el Transaction Pooler (Supabase ya agrupa las
# conexiones) o "queue" con una base directa (Docker, PostgreSQL local).
DB_POOL=null

# Migraciones: Session Pooler, puerto 5432. Si se omite, se usa DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Sesión (RNF-02)
# ---------------------------------------------------------------------------
# Genera un valor propio: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=reemplazar-por-un-secreto-aleatorio
SESSION_MAX_AGE_SECONDS=1800
SESSION_IDLE_LIMIT_SECONDS=900
# Tope absoluto de una sesión aunque se renueve (8 horas)
SESSION_ABSOLUTE_MAX_SECONDS=28800

# Orígenes del frontend separados por coma (prod: https://aspar.com,https://staging.aspar.com)
CORS_ORIGINS=http://localhost:5173

# Cuántos proxies de confianza agregan su IP al final de X-Forwarded-For.
# 0 en tu PC y en Docker; 1 en Google Cloud Run (su balanceador agrega la IP real del cliente).
PROXY_TRUSTED_HOPS=0

# ---------------------------------------------------------------------------
# Documentos privados de pacientes (RNF-06): bucket PRIVADO de Supabase Storage.
# Supabase -> Project Settings -> API Keys -> service_role (secreta: solo en el Backend).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PATIENT_DOCUMENTS_BUCKET=documentos-pacientes
SIGNED_URL_SECONDS=300
