# Configuración de entorno del Backend FastAPI ASPAR
ASPAR_ENV=development
DATABASE_URL=sqlite:///./aspar.db
# Genera un valor propio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nunca subas el secreto real al repositorio.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio
SESSION_MAX_AGE_SECONDS=1800
SESSION_IDLE_LIMIT_SECONDS=900
