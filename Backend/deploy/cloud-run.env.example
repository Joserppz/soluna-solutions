# Valores NO secretos del despliegue en Cloud Run. Copia este archivo como cloud-run.env
# (en la misma carpeta; no se sube a git) y complétalo. Las claves van con
# «bash Backend/deploy/cloud_run.sh secretos», nunca aquí.

# Región de Google Cloud: São Paulo, junto a Supabase (sa-east-1)
REGION=southamerica-east1
SERVICE=aspar-api

# Dirección del sitio en Cloudflare Pages, sin «/» al final. Los enlaces de los correos
# apuntan aquí
FRONTEND_URL=https://tu-proyecto.pages.dev

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Correos de verificación y recuperación. Sin dominio propio: Brevo con un remitente
# verificado (por ejemplo el correo de ASPAR)
EMAIL_PROVIDER=brevo
EMAIL_FROM="ASPAR <asparlapaz@gmail.com>"

# «Continuar con Google» (opcional): ID de cliente OAuth. Vacío = el botón no aparece
GOOGLE_CLIENT_ID=

# Galería (opcional): Cloudinary → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# La función de Cloudflare Pages manda la IP real de quien navega y Google agrega la de
# Cloudflare: la del cliente es la segunda contando desde el final. Con un dominio propio
# y la API en api.<dominio> (sin la función delante), vuelve a 1
PROXY_TRUSTED_HOPS=2
